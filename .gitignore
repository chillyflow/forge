# Private benchmark harness state and generated binaries; retain result evidence.
/benchmark/results/**/opencode-private.json
/benchmark/results/**/opencode-state/
/benchmark/results/**/aider-private/
/benchmark/results/**/.aider.tags.cache*/
/benchmark/results/**/*.exe
/benchmark/results/**/*.dll
/benchmark/results/**/*.db
/benchmark/results/**/*.db-wal
/benchmark/results/**/*.db-shm
# Bulk evidence archives duplicate the retained per-run files and are
# already-compressed; keep them out of history.
/benchmark/results/**/*.zip
