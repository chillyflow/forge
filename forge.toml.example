# Copy to forge.toml in your workspace, then set an existing local GGUF path.
# Relative model paths are based on the file containing the path.
# No model is downloaded. Configuration never grants tool permissions.

[model]
path = "models/qwen.gguf"
context = 16384
# enable_thinking = true # Optional Jinja template control; requires template support.

[inference]
gpu_layers = "auto"
temperature = 0.0
seed = 42
speculative = false # true is rejected: speculative decoding is not implemented.

[inference.checkpoints]
enabled = false # Explicit opt-in; retained only in this model process.
max_bytes = 268435456 # 256 MiB aggregate host allocation cap, not RSS/VRAM.
max_entries = 8
min_prefix_tokens = 128
max_captures_per_prompt = 2

[agent]
output_reserve = 2048
max_turns = 50
max_tokens = 100000

[tools.shell]
timeout = 120 # seconds; the CLI --timeout-ms override uses milliseconds.
network = false # This forbids shell execution, including --allow-exec.
# There is no network sandbox. Set true only if you accept network-capable,
# unsandboxed subprocesses, then separately authorize them with --allow-exec.

[index]
languages = ["go"] # Other languages are rejected by the current Go index.

# Optional hosted judgment service (TypeSafe "System One"/Jev). Off by default:
# configuration never grants its use; the CLI --judge flag does. When granted,
# `forge retrieve` and the agent's retrieval tool may rerank candidates before
# the output budget trim. Any service failure keeps the deterministic order.
# The API key is read from the named environment variable at call time and is
# never stored in configuration or artifacts. Calls send selected retrieval
# excerpts (paths and source snippets) to the configured endpoint.
[judge]
# endpoint = "https://api.typesafe.ai"
# model = "jev-latest"      # pin a versioned id (e.g. jev-1.13.0) for experiments
# api_key_env = "TYPESAFE_API_KEY"
# timeout_ms = 2000         # per attempt, 100..30000
# max_candidates = 32       # 1..256 candidates per rerank request
# record_dir = ".forge/judge-raw"  # optional raw request/response archive
