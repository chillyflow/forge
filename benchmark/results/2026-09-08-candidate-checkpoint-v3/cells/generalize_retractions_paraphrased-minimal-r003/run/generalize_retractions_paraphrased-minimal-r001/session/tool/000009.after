def balances(events):
    postings = {}
    totals = {}
    cancelled = set()
    
    # First pass: collect all postings and cancellations
    for event in events:
        if event['kind'] == 'post':
            postings[event['id']] = (event['account'], event['amount'])
        else:  # event['kind'] == 'retract'
            cancelled.add(event['target'])
    
    # Second pass: process postings, skipping cancelled ones
    for event_id, (account, amount) in postings.items():
        if event_id not in cancelled:
            totals.setdefault(account, 0)
            totals[account] += amount
    
    return totals
