--- a/service.py
+++ b/service.py
@@ -1,9 +1,16 @@
 def commit(documents, updates):
-    staged = documents
+    # Create a copy of the documents to work with
+    staged = documents.copy()
+    
+    # Validate all updates first
     for key, expected, value in updates:
+        # Check if document exists and has correct version
         if key not in staged or staged[key][0] != expected:
             return False
+        # Update the staged version
         staged[key] = (expected + 1, value)
+    
+    # If all validations passed, apply the updates atomically
     documents.clear()
     documents.update(staged)
     return True
