 from urllib.parse import parse_qs
+import re
 
 def parse_query(value):
-    parsed = parse_qs(value)
-    return {key: values[0] for key, values in parsed.items()}
+    # Check for malformed percent escapes before parsing
+    # A valid percent escape is %XX where X is a hexadecimal digit
+    if value and '%' in value:
+        # Find all % followed by non-hex characters
+        pattern = r'%[^0-9A-Fa-f]'
+        if re.search(pattern, value):
+            raise ValueError("Malformed percent escape")
+    
+    # Parse the query string, keeping blank values and allowing multiple values
+    parsed = parse_qs(value, keep_blank_values=True)
+    
+    # Return the last value for repeated keys
+    result = {}
+    for key, values in parsed.items():
+        if values:  # Only add if there are values
+            result[key] = values[-1]  # Get the last value
+    
+    return result
