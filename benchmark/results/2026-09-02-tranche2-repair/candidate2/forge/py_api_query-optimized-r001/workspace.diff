 from urllib.parse import parse_qs
 
 def parse_query(value):
-    parsed = parse_qs(value)
-    return {key: values[0] for key, values in parsed.items()}
+    # First, validate that the input doesn't contain malformed percent escapes
+    # Check for malformed percent encoding (like %ZZ where ZZ are not hex digits)
+    if value:
+        # Find all percent signs
+        i = 0
+        while i < len(value):
+            if value[i] == '%':
+                # Check if there are at least 2 characters after %
+                if i + 2 >= len(value):
+                    raise ValueError("Malformed percent escape")
+                # Check if the next two characters are valid hex digits
+                hex_chars = value[i+1:i+3]
+                if not all(c in '0123456789ABCDEFabcdef' for c in hex_chars):
+                    raise ValueError("Malformed percent escape")
+                i += 3  # Skip the percent and two hex characters
+            else:
+                i += 1
+    
+    # Parse the query string, keeping blank values and allowing multiple values
+    parsed = parse_qs(value, keep_blank_values=True)
+    
+    # Return the last value for repeated keys
+    result = {}
+    for key, values in parsed.items():
+        if values:  # Only add if there are values
+            result[key] = values[-1]  # Get the last value
+    
+    return result
