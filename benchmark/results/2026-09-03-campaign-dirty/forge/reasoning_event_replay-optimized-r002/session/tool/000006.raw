file_sha256:ab1e43fe924705301696fa3bb0ed80b26c2c0345c1775ccb62041ac1904e01c1
1: package repair
2: 
3: import (
4: 	"math"
5: 	"reflect"
6: 	"testing"
7: )
8: 
9: func TestReplayEvents(t *testing.T) {
10: 	events := []Event{{1, "a", "Add", "x", 3}, {2, "b", "Add", "x", -1}, {2, "b", "Add", "x", -1}, {3, "c", "Delete", "x", 0}, {4, "d", "Add", "y", 5}}
11: 	if got, ok := ReplayEvents(events); !ok || !reflect.DeepEqual(got, map[string]int{"y": 5}) {
12: 		t.Fatalf("state=%v ok=%v", got, ok)
13: 	}
14: 	invalid := [][]Event{{{2, "a", "Add", "x", 1}}, {{1, "a", "Add", "x", 1}, {1, "a", "Add", "x", 2}}, {{1, "a", "Delete", "x", 1}}, {{1, "a", "Other", "x", 0}}, {{1, "a", "Add", "x", math.MaxInt}, {2, "b", "Add", "x", 1}}}
15: 	for _, stream := range invalid {
16: 		if got, ok := ReplayEvents(stream); ok || got != nil {
17: 			t.Fatalf("accepted %v: %v", stream, got)
18: 		}
19: 	}
20: }
