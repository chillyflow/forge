package api

import (
	"encoding/json"
	"net/http"
	"strconv"
)

func ListHandler(values []string) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		page, pageErr := strconv.Atoi(r.URL.Query().Get("page"))
		size, sizeErr := strconv.Atoi(r.URL.Query().Get("size"))
		if pageErr != nil || page < 1 {
			page = 1
		}
		if sizeErr != nil || size < 1 {
			size = 10
			if sizeErr != nil {
				w.WriteHeader(http.StatusBadRequest)
				return
			}
		}
		start := (page - 1) * size
		if start > len(values) {
			start = len(values)
		}
		end := start + size
		if end > len(values) {
			end = len(values)
		}
		json.NewEncoder(w).Encode(values[start:end])
	}
}
