1: package registry
2: 
3: import "campaign.test/fixture/names"
4: 
5: type Registry struct{ values map[string]int }
6: 
7: func New() *Registry                            { return &Registry{values: map[string]int{}} }
8: func (r *Registry) Put(name string, value int)  { r.values[names.Normalize(name)] = value }
9: func (r *Registry) Get(name string) (int, bool) { value, ok := r.values[name]; return value, ok }
