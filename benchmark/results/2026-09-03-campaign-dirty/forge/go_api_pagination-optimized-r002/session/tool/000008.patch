+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+)
+
+func ListHandler(values []string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		page, err1 := strconv.Atoi(r.URL.Query().Get("page"))
+		size, err2 := strconv.Atoi(r.URL.Query().Get("size"))
+		if err1 != nil || err2 != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if page < 1 {
+			page = 1
+		}
+		if size < 1 {
+			size = 10
+		}
+		start := (page - 1) * size
+		if start > len(values) {
+			start = len(values)
+		}
+		end := start + size
+		if end > len(values) {
+			end = len(values)
+		}
+		json.NewEncoder(w).Encode(values[start:end])
+	}
+}
