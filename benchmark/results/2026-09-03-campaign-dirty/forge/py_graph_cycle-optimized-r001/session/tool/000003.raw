1: import unittest
2: from graph.order import topological_order
3: 
4: class OrderTests(unittest.TestCase):
5:     def test_dependencies_and_cycles(self):
6:         got=topological_order({"build":["compile"],"compile":["generate"],"test":["compile"]})
7:         self.assertEqual(set(got),{"build","compile","generate","test"})
8:         self.assertLess(got.index("generate"),got.index("compile")); self.assertLess(got.index("compile"),got.index("build"))
9:         with self.assertRaises(ValueError): topological_order({"a":["b"],"b":["a"]})
