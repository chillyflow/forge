1: package repair
2: 
3: import "testing"
4: 
5: func TestRepair(t *testing.T) {
6: 	xs := []int{1, 2, 3, 4, 5}
7: 	Reverse(xs)
8: 	for i, v := range xs {
9: 		if v != 5-i {
10: 			t.Fatalf("got %v", xs)
11: 		}
12: 	}
13: 	Reverse(nil)
14: }
