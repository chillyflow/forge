file_sha256:cea4d94b884ab4bc9c411d6d1d6d6f0ca790e0bf7a0cc5c287eb71e96fecceff
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             # If this posting was already cancelled by a retraction, skip it
10:             if event['id'] in cancelled:
11:                 continue
12:             account, amount = event['account'], event['amount']
13:             postings[event['id']] = (account, amount)
14:             totals.setdefault(account, 0)
15:             totals[account] += amount
16:         else:
17:             target = event['target']
18:             # If this retraction targets a posting that's already been cancelled, ignore it
19:             if target in cancelled:
20:                 continue
21:             cancelled.add(target)
22:             if target in postings:
23:                 account, amount = postings[target]
24:                 totals[account] -= amount
25:     return totals
