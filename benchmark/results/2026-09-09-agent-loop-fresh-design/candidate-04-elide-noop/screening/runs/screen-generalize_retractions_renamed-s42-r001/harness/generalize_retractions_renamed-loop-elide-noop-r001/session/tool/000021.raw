file_sha256:b09a325988ebf6980d74132029a1e4729368bae9072083219d75381469e02949
1: def positions_for(messages):
2:     entries, positions = {}, {}
3:     voided = set()
4:     
5:     for message in messages:
6:         if message['kind'] == 'post':
7:             bucket, delta = message['bucket'], message['delta']
8:             # If this post was already retracted, skip it
9:             if message['key'] in voided:
10:                 continue
11:             entries[message['key']] = (bucket, delta)
12:             positions.setdefault(bucket, 0)
13:             positions[bucket] += delta
14:         else:  # message['kind'] == 'retract'
15:             reference = message['reference']
16:             # Mark this retraction as processed
17:             if reference in voided:
18:                 continue
19:             voided.add(reference)
20:             # If the referenced post exists, subtract its delta
21:             if reference in entries:
22:                 bucket, delta = entries[reference]
23:                 positions[bucket] -= delta
24:                 del entries[reference]
25:     
