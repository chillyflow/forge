file_sha256:398ace96552a3f081d9584629cd12843c6f4a1388b76eb1f8bacad61fba7e7e0
1: def positions_for(messages):
2:     entries, positions = {}, {}
3:     voided = set()
4:     
5:     for message in messages:
6:         if message['kind'] == 'post':
7:             # Only process the first post with this key (idempotent)
8:             if message['key'] in entries:
9:                 continue
10:             bucket, delta = message['bucket'], message['delta']
11:             entries[message['key']] = (bucket, delta)
12:             positions.setdefault(bucket, 0)
13:             positions[bucket] += delta
14:         else:  # message['kind'] == 'retract'
15:             reference = message['reference']
16:             # A retraction cancels its referenced posting exactly once
17:             if reference in voided:
18:                 continue
19:             voided.add(reference)
20:             if reference in entries:
21:                 bucket, delta = entries[reference]
22:                 positions[bucket] -= delta
23:                 del entries[reference]
24:     
25:     return positions
