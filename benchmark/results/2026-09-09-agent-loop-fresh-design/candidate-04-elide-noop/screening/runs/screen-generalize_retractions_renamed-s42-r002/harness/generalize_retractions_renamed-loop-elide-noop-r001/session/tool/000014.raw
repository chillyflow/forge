file_sha256:6950cd19facf123a83a5e9dd2a5b2cbba1a91e3e8c53c672e4565d3e6932ceaf
1: def positions_for(messages):
2:     entries, positions = {}, {}
3:     voided = set()
4:     
5:     for message in messages:
6:         if message['kind'] == 'post':
7:             # If this post was already retracted, skip it
8:             if message['key'] in voided:
9:                 continue
10:             bucket, delta = message['bucket'], message['delta']
11:             entries[message['key']] = (bucket, delta)
12:             positions.setdefault(bucket, 0)
13:             positions[bucket] += delta
14:         else:  # message['kind'] == 'retract'
15:             reference = message['reference']
16:             # Mark the referenced post as voided
17:             voided.add(reference)
18:             if reference in entries:
19:                 bucket, delta = entries[reference]
20:                 positions[bucket] -= delta
21:                 del entries[reference]
22:     
23:     return positions
