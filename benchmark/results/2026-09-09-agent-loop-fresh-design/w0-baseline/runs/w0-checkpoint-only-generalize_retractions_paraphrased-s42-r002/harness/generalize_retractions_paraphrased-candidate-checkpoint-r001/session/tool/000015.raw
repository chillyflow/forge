file_sha256:52ee219fa813d5f0ff14a53e3f9a222465cdbc21a8462a8590c78882b80ffaea
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             account, amount = event['account'], event['amount']
10:             postings[event['id']] = (account, amount)
11:             totals.setdefault(account, 0)
12:             # Only add to total if not cancelled
13:             if event['id'] not in cancelled:
14:                 totals[account] += amount
15:         else:
16:             target = event['target']
17:             if target in cancelled:
18:                 continue
19:             cancelled.add(target)
20:             if target in postings:
21:                 account, amount = postings[target]
22:                 totals[account] -= amount
23:                 # Remove the posting from postings dict to ensure it's not counted again
24:                 del postings[target]
25:     return totals
