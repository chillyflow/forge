+import unittest
+from service import balances
+def post(i, amount): return {'id': i, 'kind': 'post', 'account': 'cash', 'amount': amount}
+def retract(i, target): return {'id': i, 'kind': 'retract', 'target': target}
+class BehaviorChecks(unittest.TestCase):
+    def test_order_and_duplicates(self):
+        p = post('p', 7)
+        for events in [[p, retract('r', 'p')], [retract('r', 'p'), p],
+                       [p, p, retract('r', 'p'), retract('s', 'p')]]:
+            self.assertEqual(balances(events), {'cash': 0})
+    def test_independent_postings(self):
+        self.assertEqual(balances([post('a', 7), post('b', -2), retract('r', 'a')]), {'cash': -2})
+        self.assertEqual(balances([retract('r', 'missing')]), {})
+        self.assertEqual(balances([]), {})
+    def test_void_notice_neutralizes_credit(self):
+        # Test that a retract neutralizes its referenced credit regardless of order
+        self.assertEqual(balances([retract('r', 'p'), post('p', 7)]), {'cash': 0})
+        # Test that multiple retracts work
+        self.assertEqual(balances([post('a', 5), retract('r1', 'a'), retract('r2', 'a')]), {'cash': 0})
+    def test_unknown_references(self):
+        # Test that unknown references don't create accounts
+        self.assertEqual(balances([retract('r', 'missing')]), {})
+        # Test that unknown references with valid posts work
+        self.assertEqual(balances([post('a', 5), retract('r', 'missing')]), {'cash': 5})
+    def test_account_zero_balance(self):
+        # Test that accounts with zero balance are still present
+        self.assertEqual(balances([post('a', 5), retract('r', 'a')]), {'cash': 0})
