file_sha256:5e646bc574a1869a34482ebf61f3178361064753eaf64e8a2bb9710bd2a66eb0
1: def positions_for(messages):
2:     visited, voided = set(), set()
3:     entries, positions = {}, {}
4:     for message in messages:
5:         if message['key'] in visited:
6:             continue
7:         visited.add(message['key'])
8:         if message['kind'] == 'post':
9:             bucket, delta = message['bucket'], message['delta']
10:             # If this posting was already voided by a retraction, skip it
11:             if message['key'] in voided:
12:                 continue
13:             entries[message['key']] = (bucket, delta)
14:             positions.setdefault(bucket, 0)
15:             positions[bucket] += delta
16:         else:
17:             reference = message['reference']
18:             if reference in voided:
19:                 continue
20:             voided.add(reference)
21:             if reference in entries:
22:                 bucket, delta = entries[reference]
23:                 positions[bucket] -= delta
24:                 del entries[reference]  # Remove the entry after retraction
25:     return positions
