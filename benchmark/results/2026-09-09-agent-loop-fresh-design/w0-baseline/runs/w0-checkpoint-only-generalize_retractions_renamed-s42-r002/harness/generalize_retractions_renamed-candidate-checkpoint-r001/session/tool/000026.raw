file_sha256:8a7c20a32b0e6abc8e575032c894dedd7d274fd285def7bead9322bfcdf2eb92
1: def positions_for(messages):
2:     visited, cancelled = set(), set()
3:     entries, positions = {}, {}
4:     for message in messages:
5:         if message['key'] in visited:
6:             continue
7:         visited.add(message['key'])
8:         if message['kind'] == 'post':
9:             bucket, delta = message['bucket'], message['delta']
10:             entries[message['key']] = (bucket, delta)
11:             positions.setdefault(bucket, 0)
12:             positions[bucket] += delta
13:         else:
14:             reference = message['reference']
15:             if reference in cancelled:
16:                 continue
17:             if reference in entries:
18:                 bucket, delta = entries[reference]
19:                 positions[bucket] -= delta
20:                 cancelled.add(reference)
21:     return positions
