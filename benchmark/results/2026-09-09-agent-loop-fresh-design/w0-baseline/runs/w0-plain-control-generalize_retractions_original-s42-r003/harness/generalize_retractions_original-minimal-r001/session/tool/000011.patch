+def balances(events):
+    seen = set()
+    postings = {}
+    totals = {}
+    cancelled = set()
+    
+    for event in events:
+        if event['id'] in seen:
+            continue
+        seen.add(event['id'])
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            postings[event['id']] = (account, amount)
+            totals.setdefault(account, 0)
+            totals[account] += amount
+        else:
+            target = event['target']
+            # A retraction cancels its referenced posting exactly once
+            if target not in cancelled and target in postings:
+                # The posting exists, so cancel it immediately
+                cancelled.add(target)
+                account, amount = postings[target]
+                totals[account] -= amount
+                # Remove the posting from postings dict to ensure it's only cancelled once
+                del postings[target]
+            elif target not in cancelled:
+                # The posting hasn't arrived yet, but we mark it as cancelled to prevent future cancellations
+                cancelled.add(target)
+    
+    return totals
