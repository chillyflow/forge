def positions_for(messages):
    entries, positions = {}, {}
    voided = set()
    
    for message in messages:
        if message['kind'] == 'post':
            # If this post was already voided by a retraction, skip it
            if message['key'] in voided:
                continue
            bucket, delta = message['bucket'], message['delta']
            entries[message['key']] = (bucket, delta)
            positions.setdefault(bucket, 0)
            positions[bucket] += delta
        else:  # message['kind'] == 'retract'
            reference = message['reference']
            if reference in voided:
                continue
            voided.add(reference)
            if reference in entries:
                bucket, delta = entries[reference]
                positions[bucket] -= delta
                del entries[reference]
            # If the referenced post hasn't been processed yet, we still mark it as voided
            # but we should ensure that bucket is included in positions if it was referenced
            # This is tricky - we don't actually modify positions but need to track reference
    
    # Actually, let's approach this differently. The key is that we need to track
    # which buckets were referenced in posts or retractions, even if they end up with zero
    # But the current approach is correct - if no entries are added to a bucket, 
    # it shouldn't appear in the result
    
    # Wait, let me check what the actual requirement means by looking at the test expectations
    # The issue is that we're not tracking when buckets are referenced for retraction purposes
    
    # Let me try a different approach - for retractions that reference posts not yet processed,
    # we should still make sure the bucket gets included in the result if it's ever referenced
    return positions
