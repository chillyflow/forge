+import sys
+sys.path.append('.')
+from ledger import positions_for
+
+def post(i, delta): 
+    return {'key': i, 'kind': 'post', 'bucket': 'cash', 'delta': delta}
+
+def retract(i, reference): 
+    return {'key': i, 'kind': 'retract', 'reference': reference}
+
+# Test the failing case
+p = post('p', 7)
+messages = [p, retract('r', 'p')]
+print("Messages:", messages)
+
+result = positions_for(messages)
+print("Result:", result)
+print("Expected: {'cash': 0}")
+
+# Let's also test the reverse order
+messages2 = [retract('r', 'p'), p]
+print("\nReverse order messages:", messages2)
+result2 = positions_for(messages2)
+print("Result:", result2)
+print("Expected: {'cash': 0}")
+
+# Test the third case
+messages3 = [p, p, retract('r', 'p'), retract('s', 'p')]
+print("\nThird case messages:", messages3)
+result3 = positions_for(messages3)
+print("Result:", result3)
+print("Expected: {'cash': 0}")
+
+# Now let's run the exact test case that's failing
+print("\n--- Running exact test case ---")
+p = post('p', 7)
+for messages in [[p, retract('r', 'p')], [retract('r', 'p'), p],
+               [p, p, retract('r', 'p'), retract('s', 'p')]]:
+    result = positions_for(messages)
+    print(f"Messages {messages} -> Result: {result}")
