+def positions_for(messages):
+    visited, voided = set(), set()
+    entries, positions = {}, {}
+    for message in messages:
+        if message['key'] in visited:
+            continue
+        visited.add(message['key'])
+        if message['kind'] == 'post':
+            bucket, delta = message['bucket'], message['delta']
+            # If this posting is voided (retraction arrived first), skip it
+            if message['key'] in voided:
+                continue
+            entries[message['key']] = (bucket, delta)
+            positions.setdefault(bucket, 0)
+            positions[bucket] += delta
+        else:
+            reference = message['reference']
+            if reference in voided:
+                continue
+            voided.add(reference)
+            if reference in entries:
+                bucket, delta = entries[reference]
+                positions[bucket] -= delta
+            # Handle case where retraction arrives before posting - ensure bucket exists
+            else:
+                # This is a retraction for a non-existent posting, but we still need to ensure
+                # the bucket exists in positions for the "zero entry" requirement
+                positions.setdefault(reference, 0)
+    return positions
