def balances(events):
    seen, cancelled = set(), set()
    postings, totals = {}, {}
    for event in events:
        if event['id'] in seen:
            continue
        seen.add(event['id'])
        if event['kind'] == 'post':
            account, amount = event['account'], event['amount']
            postings[event['id']] = (account, amount)
            if event['id'] not in cancelled:
                totals.setdefault(account, 0)
                totals[account] += amount
        else:
            target = event['target']
            if target in cancelled:
                continue
            if target in postings:
                cancelled.add(target)
                account, amount = postings[target]
                totals[account] -= amount
            # If target is not in postings, we don't add it to cancelled
            # because it would be an unmatched retraction with no balance effect
    return totals
