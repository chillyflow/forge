def balances(events):
    seen, cancelled = set(), set()
    postings, totals = {}, {}
    for event in events:
        if event['id'] in seen:
            continue
        seen.add(event['id'])
        if event['kind'] == 'post':
            account, amount = event['account'], event['amount']
            postings[event['id']] = (account, amount)
            if event['id'] not in cancelled:
                totals.setdefault(account, 0)
                totals[account] += amount
        else:
            target = event['target']
            if target in cancelled:
                continue
            if target in postings:
                cancelled.add(target)
                account, amount = postings[target]
                totals[account] -= amount
            else:
                # If target is not in postings, mark it as cancelled (unmatched retraction)
                # We need to track the account that would be affected by this retraction
                # Since we don't have the account info in the retraction, we'll track it differently
                cancelled.add(target)
                # For unmatched retractions, we don't need to add to totals since there's no posting to cancel
    return totals
