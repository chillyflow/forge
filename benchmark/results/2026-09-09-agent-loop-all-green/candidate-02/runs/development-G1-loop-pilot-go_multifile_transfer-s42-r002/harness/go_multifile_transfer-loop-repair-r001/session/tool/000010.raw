file_sha256:47e71fd29c3b3058303df1d768e8f7e5091337be5a2d8b648714ad4fa29fb82b
1: package ledger
2: 
3: import "errors"
4: 
5: func Transfer(from, to *Ledger, amount int) error {
6: 	if amount < 0 {
7: 		return errors.New("invalid amount")
8: 	}
9: 	
10: 	// Check if source has sufficient funds
11: 	if !from.debit(amount) {
12: 		return errors.New("insufficient funds")
13: 	}
14: 	
15: 	// Credit the destination ledger
16: 	to.Balance += amount
17: 	
18: 	return nil
19: }
