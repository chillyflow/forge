+    def cached_code(path, content):
+        # Match the current source's timestamp and size without changing its bytes.
+        code = (
+            "import pathlib,os,py_compile,importlib.util,tempfile;"
+            f"p=pathlib.Path({path!r});"
+            "t=tempfile.NamedTemporaryFile(suffix='.py',delete=False);"
+            "q=pathlib.Path(t.name);t.close();"
+            f"q.write_bytes({content.encode('utf-8')!r});"
+            "s=p.stat();os.utime(q,ns=(s.st_atime_ns,s.st_mtime_ns));"
+            "py_compile.compile(str(q),cfile=importlib.util.cache_from_source(str(p)),"
+            "dfile=str(p),doraise=True,invalidation_mode=py_compile.PycInvalidationMode.TIMESTAMP);"
+            "q.unlink()")
+        return call("run_command", {"argv": [sys.executable, "-c", code]})
+
+    def assert_cached_success_rejected(self, path, content, *options):
+        _, events = self.run_script([
+            self.cached_code(path, content), validate(), final("Cached success must not be accepted.")],
+            "--max-turns", "3", *options, success=False)
+        self.assertEqual((self.root / "value.py").read_text(encoding="utf-8"), self.source)
+        self.assertFalse(self.kind(events, "final"))
+        checkpoints = self.kind(events, "candidate_checkpoint")
+        self.assertTrue(checkpoints)
+        self.assertFalse(any(item["passed"] for item in checkpoints))
+
+    def test_checkpoint_rejects_stale_passing_module_bytecode(self):
+        self.assert_cached_success_rejected("value.py", self.source.replace("return 1", "return 2"))
+
+    def test_bounded_checkpoint_rejects_stale_passing_test_bytecode(self):
