def balances(events):
    seen, cancelled = set(), set()
    postings, totals = {}, {}
    # First pass: collect all postings and cancellations
    for event in events:
        if event['id'] in seen:
            continue
        seen.add(event['id'])
        if event['kind'] == 'post':
            account, amount = event['account'], event['amount']
            postings[event['id']] = (account, amount)
        else:
            target = event['target']
            cancelled.add(target)
    
    # Second pass: apply the logic, checking if postings are cancelled
    seen = set()  # Reset seen for second pass
    for event in events:
        if event['id'] in seen:
            continue
        seen.add(event['id'])
        if event['kind'] == 'post':
            account, amount = event['account'], event['amount']
            # Only process if not cancelled
            if event['id'] not in cancelled:
                totals.setdefault(account, 0)
                totals[account] += amount
        else:
            target = event['target']
            # If target is cancelled, we already processed it in the first pass
            # We just need to ensure it doesn't affect totals if it was already processed
            pass
    
    return totals
