8: func ResolveMount(request string, mounts []string) (string, string, bool) {
9: 	request = path.Clean("/" + request)
10: 	best := ""
11: 	for _, raw := range mounts {
12: 		mount := path.Clean("/" + raw)
13: 		if mount == "/" || strings.HasPrefix(request, mount+"/") || (mount != "/" && strings.HasPrefix(request, mount) && len(request) > len(mount)) {
14: 			if len(mount) > len(best) {
15: 				best = mount
16: 			}
17: 		}
18: 	}
19: 	if best == "" {
