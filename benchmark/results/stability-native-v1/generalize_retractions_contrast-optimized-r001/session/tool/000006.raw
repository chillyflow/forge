1: import unittest
2: from service import balances
3: def post(i, amount): return {'id': i, 'kind': 'post', 'account': 'cash', 'amount': amount}
4: def retract(i, target): return {'id': i, 'kind': 'retract', 'target': target}
5: class Retractions(unittest.TestCase):
6:     def test_arrival_order(self):
7:         p = post('p', 7)
8:         self.assertEqual(balances([retract('early', 'p'), p]), {'cash': 7})
9:         self.assertEqual(balances([retract('early', 'p'), p, retract('later', 'p')]), {'cash': 0})
10:         self.assertEqual(balances([p, p, retract('r', 'p'), retract('s', 'p')]), {'cash': 0})
11:         self.assertEqual(balances([retract('same', 'p'), p, retract('same', 'p')]), {'cash': 7})
12:         self.assertEqual(balances([retract('r', 'missing')]), {})
13:         self.assertEqual(balances([]), {})
