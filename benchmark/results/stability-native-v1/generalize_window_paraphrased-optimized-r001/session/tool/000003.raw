file_sha256:5d3f8917cc1f8f4bfd0f3ab7923493178e2e2096ca5c759f45d56bfc876840c5
1: package holdout
2: 
3: import "testing"
4: 
5: func TestWindow(t *testing.T) {
6: 	w := Window{Width: 5}
7: 	for _, tc := range []struct{ at, value, want int }{{0, 3, 3}, {4, 2, 5}, {5, 7, 9}, {5, -2, 7}, {10, 1, 1}} {
8: 		got, ok := w.Add(tc.at, tc.value)
9: 		if !ok || got != tc.want {
10: 			t.Fatalf("tick %d aggregate mismatch: %d", tc.at, got)
11: 		}
12: 	}
13: 	if _, ok := w.Add(9, 100); ok {
14: 		t.Fatal("monotonicity contract violated")
15: 	}
16: 	if got, ok := w.Add(10, 2); !ok || got != 3 {
17: 		t.Fatal(got, ok)
18: 	}
19: }
