def balances(events):
    seen, cancelled = set(), set()
    postings, totals = {}, {}
    for event in events:
        if event['id'] in seen:
            continue
        seen.add(event['id'])
        if event['kind'] == 'post':
            account, amount = event['account'], event['amount']
            postings[event['id']] = (account, amount)
            totals.setdefault(account, 0)
            totals[account] += amount
        else:
            target = event['target']
            if target in cancelled:
                continue
            cancelled.add(target)
            if target in postings:
                account, amount = postings[target]
                totals[account] -= amount
            # If target is not in postings, it's an unknown reference - no account created
            # But we still need to mark the target as cancelled for future posts
    # Process all cancelled posts to ensure they're properly handled
    for post_id, (account, amount) in list(postings.items()):
        if post_id in cancelled:
            totals[account] -= amount
    return totals
