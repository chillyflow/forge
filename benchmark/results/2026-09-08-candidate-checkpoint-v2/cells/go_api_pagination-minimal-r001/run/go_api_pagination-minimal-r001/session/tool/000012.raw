file_sha256:751b8f143e1c4ffe8a02107c637ee886d92f0c3d15135a19d0065238435679b1
1: package api
2: 
3: import (
4: 	"encoding/json"
5: 	"net/http"
6: 	"strconv"
7: )
8: 
9: func ListHandler(values []string) http.HandlerFunc {
10: 	return func(w http.ResponseWriter, r *http.Request) {
11: 		pageStr := r.URL.Query().Get("page")
12: 		sizeStr := r.URL.Query().Get("size")
13: 		
14: 		page, err := strconv.Atoi(pageStr)
15: 		if err != nil || page < 1 {
16: 			http.Error(w, "Invalid page", http.StatusBadRequest)
17: 			return
18: 		}
19: 		
20: 		size, err := strconv.Atoi(sizeStr)
21: 		if err != nil || size < 1 {
22: 			http.Error(w, "Invalid size", http.StatusBadRequest)
23: 			return
24: 		}
25: 		
26: 		// Convert to zero-based indexing
27: 		start := (page - 1) * size
28: 		if start >= len(values) {
29: 			start = len(values)
30: 		}
