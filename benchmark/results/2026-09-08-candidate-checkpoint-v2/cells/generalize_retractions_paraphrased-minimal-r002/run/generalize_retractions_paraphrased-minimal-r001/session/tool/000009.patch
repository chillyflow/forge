+def balances(events):
+    seen, cancelled = set(), set()
+    postings, totals = {}, {}
+    for event in events:
+        if event['id'] in seen:
+            continue
+        seen.add(event['id'])
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            postings[event['id']] = (account, amount)
+            totals.setdefault(account, 0)
+            totals[account] += amount
+        else:
+            target = event['target']
+            if target in cancelled:
+                continue
+            cancelled.add(target)
+            if target in postings:
+                account, amount = postings[target]
+                totals[account] -= amount
+            # If target is not in postings, it means the posting hasn't happened yet
+            # or was already cancelled, so we mark it as cancelled for when it does happen
+    # Process cancelled postings to ensure they don't contribute
+    for posting_id, (account, amount) in list(postings.items()):
+        if posting_id in cancelled:
+            totals[account] -= amount
+    return totals
