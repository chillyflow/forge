+package repair
+
+import "strings"
+
+type Route struct{ Method, Pattern, Name string }
+type routeMatch struct {
+	name                                    string
+	params                                  map[string]string
+	literals, methodExact, wildcards, index int
+}
+
+func routeSegments(value string) []string {
+	value = strings.Trim(value, "/")
+	if value == "" {
+		return nil
+	}
+	return strings.Split(value, "/")
+}
+
+func MatchRoute(method, path string, routes []Route) (string, map[string]string, bool) {
+	actual := routeSegments(path)
+	var best routeMatch
+	found := false
+	
+	for index, route := range routes {
+		// Check method match
+		if route.Method != "*" && route.Method != method {
+			continue
+		}
+		
+		pattern := routeSegments(route.Pattern)
+		params := map[string]string{}
+		literals, wildcards := 0, 0
+		pi, ai := 0, 0
+		ok := true
+		
+		// Match pattern segments with path segments
+		for pi < len(pattern) && ai < len(actual) {
+			part := pattern[pi]
+			
+			if part == "*" {
+				// Wildcard must be the last segment
+				if pi != len(pattern)-1 {
+					ok = false
+					break
+				}
+				// Wildcard must match non-empty suffix
+				if len(actual[ai:]) == 0 {
+					ok = false
+					break
+				}
+				params["*"] = strings.Join(actual[ai:], "/")
+				wildcards++
+				ai = len(actual)
+				pi++
+				break
+			}
+			
+			if strings.HasPrefix(part, ":") && len(part) > 1 {
+				// Parameter segment - capture the value
+				params[part[1:]] = actual[ai]
+				wildcards++
+			} else if part == actual[ai] {
+				// Literal segment match
+				literals++
+			} else {
+				// No match
+				ok = false
+				break
+			}
+			
+			pi++
+			ai++
+		}
+		
+		// Check if we consumed all pattern and path segments
+		if !ok || pi != len(pattern) || ai != len(actual) {
+			continue
+		}
+		
+		// Calculate match quality
+		methodExact := 0
+		if route.Method == method {
+			methodExact = 1
+		}
+		
+		candidate := routeMatch{route.Name, params, literals, methodExact, wildcards, index}
+		
+		// Apply tie-breaking rules:
+		// 1. Prefer more literal segments
+		// 2. Prefer exact method over *
+		// 3. Prefer fewer wildcards
+		// 4. Preserve declaration order (index)
+		if !found || 
+		   candidate.literals > best.literals ||
+		   (candidate.literals == best.literals && candidate.methodExact > best.methodExact) ||
+		   (candidate.literals == best.literals && candidate.methodExact == best.methodExact && candidate.wildcards < best.wildcards) ||
+		   (candidate.literals == best.literals && candidate.methodExact == best.methodExact && candidate.wildcards == best.wildcards && candidate.index < best.index) {
+			best = candidate
+			found = true
+		}
+	}
+	
+	if !found {
+		return "", nil, false
+	}
+	return best.name, best.params, true
+}
