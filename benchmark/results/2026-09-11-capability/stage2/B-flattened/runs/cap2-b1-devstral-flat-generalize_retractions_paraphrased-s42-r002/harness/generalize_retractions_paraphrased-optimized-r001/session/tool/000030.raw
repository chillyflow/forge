+def balances(events):
+    cancelled = set()
+    totals = {}
+    
+    for event in events:
+        event_id = event['id']
+        if event_id in cancelled:
+            continue
+            
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            if event_id not in cancelled:
+                totals.setdefault(account, 0)
+                totals[account] += amount
+        elif event['kind'] == 'retract':
+            target = event['target']
+            if target in cancelled:
+                continue
+            cancelled.add(target)
+            if target in totals:
+                account = event['account'] if 'account' in event else None
+                if account and account in totals:
+                    totals[account] -= totals.get(target, 0)
+                else:
+                    for acc, amt in totals.items():
+                        if acc == target:
+                            totals[acc] -= amt
+                            break
+    
+    return totals

