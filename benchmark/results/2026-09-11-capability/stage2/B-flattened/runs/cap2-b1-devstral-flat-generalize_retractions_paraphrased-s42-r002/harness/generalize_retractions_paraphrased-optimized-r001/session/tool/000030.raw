+def balances(events):
+    seen, postings, totals = set(), {}, {}
+    
+    # First pass: collect all unique post events
+    for event in events:
+        if event['id'] in seen:
+            continue
+        seen.add(event['id'])
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            postings[event['id']] = (account, amount)
+            totals.setdefault(account, 0)
+            totals[account] += amount
+    
+    # Second pass: process retract events (only unique ones not already seen)
+    seen.clear()
+    for event in events:
+        if event['id'] in seen:
+            continue
+        seen.add(event['id'])
+        if event['kind'] == 'retract':
+            target = event['target']
+            if target in postings:
+                account, amount = postings[target]
+                totals[account] -= amount
+    
+    return totals

