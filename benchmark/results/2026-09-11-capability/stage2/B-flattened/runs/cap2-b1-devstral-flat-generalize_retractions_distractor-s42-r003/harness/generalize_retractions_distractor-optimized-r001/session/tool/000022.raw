def balances(events):
    seen, cancelled = set(), set()
    postings, accounts = {}, set()
    
    # First pass: collect all postings and retractions
    for event in events:
        if event['id'] in seen:
            continue
        seen.add(event['id'])
        if event['kind'] == 'post':
            account, amount = event['account'], event['amount']
            postings[event['id']] = (account, amount)
            accounts.add(account)
        else:  # retract
            target = event['target']
            if target not in cancelled:
                cancelled.add(target)
    
    # Calculate net balances for all accounts
    totals = {}
    for account in accounts:
        net_balance = 0
        for event_id, (acc, amount) in postings.items():
            if acc == account and event_id not in cancelled:
                net_balance += amount
        totals[account] = net_balance
    
    return totals
