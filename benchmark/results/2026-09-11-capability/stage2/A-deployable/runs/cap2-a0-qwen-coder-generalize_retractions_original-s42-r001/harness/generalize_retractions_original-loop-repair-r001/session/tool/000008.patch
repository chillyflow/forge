+def balances(events):
+    seen, cancelled = set(), set()
+    postings, totals = {}, {}
+    pending_retractions = {}
+    
+    for event in events:
+        if event['id'] in seen:
+            continue
+        seen.add(event['id'])
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            postings[event['id']] = (account, amount)
+            totals.setdefault(account, 0)
+            totals[account] += amount
+        else:
+            target = event['target']
+            if target in cancelled:
+                continue
+            cancelled.add(target)
+            if target in postings:
+                account, amount = postings[target]
+                totals[account] -= amount
+            else:
+                # If the posting hasn't arrived yet, store this retraction for later
+                if target not in pending_retractions:
+                    pending_retractions[target] = []
+                pending_retractions[target].append(event['id'])
+    
+    # Process any pending retractions that might reference postings that arrived later
+    # This handles the case where a retraction arrives before its posting
+    for posting_id, (account, amount) in postings.items():
+        if posting_id in pending_retractions:
+            for retraction_id in pending_retractions[posting_id]:
+                cancelled.add(retraction_id)
+                totals[account] -= amount
+    
+    return totals
