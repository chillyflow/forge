file_sha256:355619ff4836c3d6074154fb2b29949d49776978dc8055823c492ba8246b2973
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             account, amount = event['account'], event['amount']
10:             # If this posting was already cancelled by an earlier retraction, skip it
11:             if event['id'] in cancelled:
12:                 continue
13:             postings[event['id']] = (account, amount)
14:             totals.setdefault(account, 0)
15:             totals[account] += amount
16:         else:
17:             target = event['target']
18:             # Mark the target as cancelled (even if it hasn't arrived yet)
19:             cancelled.add(target)
20:             # If the posting for this target has already arrived, cancel it
21:             if target in postings:
22:                 account, amount = postings[target]
23:                 totals[account] -= amount
24:     return totals
