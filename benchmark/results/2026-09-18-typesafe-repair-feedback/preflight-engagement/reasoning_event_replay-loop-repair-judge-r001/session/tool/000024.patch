+package main
+
+import (
+	"fmt"
+	"reflect"
+)
+
+type Event struct {
+	Seq           int
+	ID, Kind, Key string
+	Delta         int
+}
+
+func ReplayEvents(events []Event) (map[string]int, bool) {
+	state := map[string]int{}
+	seen := map[string]Event{}
+	expected := 1
+	maxInt := int(^uint(0) >> 1)
+	minInt := -maxInt - 1
+	fmt.Printf("Starting with %d events\n", len(events))
+	for i, event := range events {
+		fmt.Printf("Event %d: %+v\n", i, event)
+		if event.ID == "" || event.Key == "" {
+			fmt.Printf("  Invalid ID or Key\n")
+			return nil, false
+		}
+		if event.Seq != expected {
+			fmt.Printf("  Sequence mismatch: got %d, expected %d\n", event.Seq, expected)
+			return nil, false
+		}
+		expected++
+		fmt.Printf("  Sequence OK, expected now %d\n", expected)
+		// Check for duplicate events with same ID and full payload
+		if existing, ok := seen[event.ID]; ok {
+			fmt.Printf("  Duplicate check: existing=%+v, current=%+v\n", existing, event)
+			if existing != event {
+				fmt.Printf("  Payload mismatch\n")
+				return nil, false
+			}
+			fmt.Printf("  Skipping duplicate\n")
+			continue
+		}
+		seen[event.ID] = event
+		fmt.Printf("  Processing kind=%s\n", event.Kind)
+		switch event.Kind {
+		case "Add":
+			current := state[event.Key]
+			fmt.Printf("  Add: current=%d, delta=%d\n", current, event.Delta)
+			if event.Delta > 0 && current > maxInt-event.Delta || event.Delta < 0 && current < minInt-event.Delta {
+				fmt.Printf("  Overflow detected\n")
+				return nil, false
+			}
+			state[event.Key] = current + event.Delta
+			fmt.Printf("  New state[%s] = %d\n", event.Key, state[event.Key])
+		case "Delete":
+			if event.Delta != 0 {
+				fmt.Printf("  Delete with non-zero delta\n")
+				return nil, false
+			}
+			delete(state, event.Key)
+			fmt.Printf("  Deleted key %s\n", event.Key)
+		default:
+			fmt.Printf("  Invalid kind\n")
+			return nil, false
+		}
+		fmt.Printf("  State after event: %v\n", state)
+	}
+	fmt.Printf("Final state: %v\n", state)
+	return state, true
+}
+
+func main() {
+	events := []Event{{1, "a", "Add", "x", 3}, {2, "b", "Add", "x", -1}, {2, "b", "Add", "x", -1}, {3, "c", "Delete", "x", 0}, {4, "d", "Add", "y", 5}}
+	result, ok := ReplayEvents(events)
+	fmt.Printf("Result: %v, ok: %v\n", result, ok)
+}
