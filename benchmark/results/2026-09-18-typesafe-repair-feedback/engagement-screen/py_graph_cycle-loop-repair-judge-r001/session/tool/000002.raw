1: def topological_order(graph):
2:     result, visiting = [], set()
3:     def visit(node):
4:         if node in visiting:
5:             return
6:         visiting.add(node)
7:         for dependency in graph.get(node, []):
8:             visit(dependency)
9:         result.append(node)
10:     for node in graph:
11:         visit(node)
12:     return result
