7: 
8: func TestPrecedence(t *testing.T) {
9: 	got := Resolve(Values{"host": "default", "port": "80"}, Values{"host": "file"}, Values{"host": "runtime"})
10: 	want := Values{"host": "runtime", "port": "80"}
11: 	if !reflect.DeepEqual(got, want) {
12: 		t.Fatalf("got %v", got)
13: 	}
14: }
