3: import "testing"
4: 
5: func TestRepair(t *testing.T) {
6: 	if got := Add(2, 3); got != 5 {
7: 		t.Fatalf("expected 5, got %d", got)
8: 	}
9: 	if Add(-2, 3) != 1 {
10: 		t.Fatal("negative operands")
11: 	}
12: }
