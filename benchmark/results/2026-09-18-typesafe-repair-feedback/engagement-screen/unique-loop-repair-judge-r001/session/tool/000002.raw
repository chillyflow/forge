file_sha256:2671e55e637b65f61ddf54170d7d3dbcb8b8e90fe76407ceb28e7c1b34cc8ae1
1: package repair
2: 
3: func Unique(xs []int) []int {
4: 	out := []int{}
5: 	seen := map[int]bool{}
6: 	for _, v := range xs {
7: 		if seen[v] {
8: 			out = append(out, v)
9: 		}
10: 		seen[v] = true
11: 	}
12: 	return out
13: }
