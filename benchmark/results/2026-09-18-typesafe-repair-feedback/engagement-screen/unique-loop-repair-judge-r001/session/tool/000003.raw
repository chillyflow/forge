3: import "testing"
4: 
5: func TestRepair(t *testing.T) {
6: 	got := Unique([]int{3, 1, 3, 2, 1})
7: 	want := []int{3, 1, 2}
8: 	if len(got) != len(want) {
9: 		t.Fatalf("got %v", got)
10: 	}
11: 	for i := range want {
12: 		if got[i] != want[i] {
13: 			t.Fatalf("got %v", got)
14: 		}
15: 	}
16: }
