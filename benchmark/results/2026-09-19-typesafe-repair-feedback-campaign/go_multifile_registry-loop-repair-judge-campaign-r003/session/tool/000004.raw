1: package registry
2: 
3: import "testing"
4: 
5: func TestNormalizedNames(t *testing.T) {
6: 	r := New()
7: 	r.Put("  Alpha ", 7)
8: 	for _, key := range []string{"alpha", " ALPHA ", "Alpha"} {
9: 		if got, ok := r.Get(key); !ok || got != 7 {
10: 			t.Fatalf("%q=(%d,%v)", key, got, ok)
11: 		}
12: 	}
13: }
