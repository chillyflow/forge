1: package repair
2: 
3: import "testing"
4: 
5: func TestRepair(t *testing.T) {
6: 	if TrimPrefix("abab", "ab") != "ab" || TrimPrefix("zab", "ab") != "zab" || TrimPrefix("abc", "") != "abc" {
7: 		t.Fatal("prefix semantics failed")
8: 	}
9: }
