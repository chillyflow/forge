file_sha256:3690ec0f6fc154fe4f5cfb19bb30cdebd3a3d23e1c24c1c182830a0a4640a6ff
1: package repair
2: 
3: import "sort"
4: 
5: type Interval struct{ Lo, Hi int }
6: 
7: func UnionIntervals(in []Interval) []Interval {
8: 	if len(in) == 0 {
9: 		return []Interval{}
10: 	}
11: 
12: 	// Create a copy to avoid mutating the input
13: 	out := make([]Interval, len(in))
14: 	for i, interval := range in {
15: 		if interval.Lo > interval.Hi {
16: 			out[i].Lo, out[i].Hi = interval.Hi, interval.Lo
17: 		} else {
18: 			out[i].Lo, out[i].Hi = interval.Lo, interval.Hi
19: 		}
20: 	}
21: 
22: 	// Sort intervals
23: 	sort.Slice(out, func(i, j int) bool {
24: 		if out[i].Lo == out[j].Lo {
25: 			return out[i].Hi < out[j].Hi
26: 		}
27: 		return out[i].Lo < out[j].Lo
28: 	})
29: 
30: 	// Merge overlapping and adjacent intervals
31: 	merged := make([]Interval, 0, len(out))
32: 	for _, current := range out {
33: 		if len(merged) == 0 {
34: 			merged = append(merged, current)
35: 			continue
36: 		}
37: 
38: 		// Check if current interval overlaps or is adjacent to the last merged interval
39: 		last := &merged[len(merged)-1]
40: 		if current.Lo <= last.Hi+1 {
41: 			// Overlapping or adjacent - merge them
42: 			if current.Hi > last.Hi {
43: 				last.Hi = current.Hi
44: 			}
45: 		} else {
46: 			// Non-overlapping - add as new interval
47: 			merged = append(merged, current)
48: 		}
49: 	}
50: 
