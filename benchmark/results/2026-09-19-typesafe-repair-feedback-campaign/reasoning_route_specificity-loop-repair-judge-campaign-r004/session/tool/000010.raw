file_sha256:d5df2d2d0e60d0e91aa0f88285a572628954a93625801d4ba2bd87f7eca395c2
1: package repair
2: 
3: import "strings"
4: 
5: type Route struct{ Method, Pattern, Name string }
6: type routeMatch struct {
7: 	name                                    string
8: 	params                                  map[string]string
9: 	literals, methodExact, wildcards, index int
10: }
11: 
12: func routeSegments(value string) []string {
13: 	value = strings.Trim(value, "/")
14: 	if value == "" {
15: 		return nil
16: 	}
17: 	return strings.Split(value, "/")
18: }
19: func MatchRoute(method, path string, routes []Route) (string, map[string]string, bool) {
20: 	actual := routeSegments(path)
21: 	var best routeMatch
22: 	found := false
23: 	for index, route := range routes {
24: 		if route.Method != "*" && route.Method != method {
25: 			continue
26: 		}
27: 		pattern := routeSegments(route.Pattern)
28: 		params := map[string]string{}
29: 		literals, wildcards := 0, 0
30: 		pi, ai := 0, 0
31: 		ok := true
32: 		for pi < len(pattern) && ai < len(actual) {
33: 			part := pattern[pi]
34: 			if part == "*" {
35: 				if pi != len(pattern)-1 {
36: 					ok = false
37: 					break
38: 				}
39: 				if ai >= len(actual) {
40: 					ok = false
41: 					break
42: 				}
43: 				params["*"] = strings.Join(actual[ai:], "/")
44: 				wildcards++
45: 				ai = len(actual)
46: 				pi++
47: 				break
48: 			}
49: 			if ai >= len(actual) {
50: 				ok = false
51: 				break
52: 			}
53: 			if strings.HasPrefix(part, ":") && len(part) > 1 {
54: 				params[part[1:]] = actual[ai]
55: 				wildcards++
56: 			} else if part == actual[ai] {
57: 				literals++
58: 			} else {
59: 				ok = false
60: 				break
61: 			}
62: 			pi++
63: 			ai++
64: 		}
65: 		if !ok || pi != len(pattern) || ai != len(actual) {
66: 			continue
67: 		}
68: 		exact := 0
69: 		if route.Method == method {
70: 			exact = 1
71: 		}
72: 		candidate := routeMatch{route.Name, params, literals, exact, wildcards, index}
73: 		// Prefer: more literals, then exact method over *, then fewer wildcards, then earlier declaration
74: 		if !found ||
75: 			candidate.literals > best.literals ||
76: 			(candidate.literals == best.literals && candidate.methodExact > best.methodExact) ||
77: 			(candidate.literals == best.literals && candidate.methodExact == best.methodExact && candidate.wildcards < best.wildcards) ||
78: 			(candidate.literals == best.literals && candidate.methodExact == best.methodExact && candidate.wildcards == best.wildcards && candidate.index < best.index) {
79: 			best = candidate
80: 			found = true
81: 		}
82: 	}
83: 	if !found {
84: 		return "", nil, false
85: 	}
86: 	return best.name, best.params, true
87: }
