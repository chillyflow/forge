1: package repair
2: 
3: import "testing"
4: 
5: func TestRepair(t *testing.T) {
6: 	if RangeSum(1, 3) != 6 || RangeSum(5, 5) != 5 || RangeSum(3, 1) != 0 || RangeSum(-2, 2) != 0 {
7: 		t.Fatal("inclusive sum failed")
8: 	}
9: }
