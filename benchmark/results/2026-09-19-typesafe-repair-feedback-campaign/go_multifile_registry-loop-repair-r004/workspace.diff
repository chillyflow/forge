diff --git a/names/normalize.go b/names/normalize.go
index a1ada4c..786f368 100644
--- a/names/normalize.go
+++ b/names/normalize.go
@@ -1,5 +1,13 @@
 package names
 
-import "strings"
+import (
+	"strings"
+	"unicode"
+)
 
-func Normalize(value string) string { return strings.TrimSpace(value) }
+func Normalize(value string) string {
+	// Trim whitespace
+	value = strings.TrimSpace(value)
+	// Convert to lowercase
+	return strings.Map(unicode.ToLower, value)
+}
