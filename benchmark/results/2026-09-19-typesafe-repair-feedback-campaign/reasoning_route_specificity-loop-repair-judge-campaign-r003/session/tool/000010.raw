file_sha256:e963d240ca1abd48a71ec4506253c1d8ba77f26927bd2c116d2e7756995ed5e8
1: package repair
2: 
3: import "strings"
4: 
5: type Route struct{ Method, Pattern, Name string }
6: type routeMatch struct {
7: 	name                                    string
8: 	params                                  map[string]string
9: 	literals, methodExact, wildcards, index int
10: }
11: 
12: func routeSegments(value string) []string {
13: 	value = strings.Trim(value, "/")
14: 	if value == "" {
15: 		return nil
16: 	}
17: 	return strings.Split(value, "/")
18: }
19: func MatchRoute(method, path string, routes []Route) (string, map[string]string, bool) {
20: 	actual := routeSegments(path)
21: 	var best routeMatch
22: 	found := false
23: 	for index, route := range routes {
24: 		if route.Method != "*" && route.Method != method {
25: 			continue
26: 		}
27: 		pattern := routeSegments(route.Pattern)
28: 		params := map[string]string{}
29: 		literals, wildcards := 0, 0
30: 		pi, ai := 0, 0
31: 		ok := true
32: 		for pi < len(pattern) {
33: 			part := pattern[pi]
34: 			if part == "*" {
35: 				if pi != len(pattern)-1 || ai >= len(actual) {
36: 					ok = false
37: 					break
38: 				}
39: 				params["*"] = strings.Join(actual[ai:], "/")
40: 				wildcards++
41: 				ai = len(actual)
42: 				pi++
43: 				break
44: 			}
45: 			if ai >= len(actual) {
46: 				ok = false
47: 				break
48: 			}
49: 			if strings.HasPrefix(part, ":") && len(part) > 1 {
50: 				params[part[1:]] = actual[ai]
51: 				wildcards++
52: 				literals++
53: 			} else if part == actual[ai] {
54: 				literals++
55: 			} else {
56: 				ok = false
57: 				break
58: 			}
59: 			pi++
60: 			ai++
61: 		}
62: 		if !ok || pi != len(pattern) || ai != len(actual) {
63: 			continue
64: 		}
65: 		exact := 0
66: 		if route.Method == method {
67: 			exact = 1
68: 		}
69: 		candidate := routeMatch{route.Name, params, literals, exact, wildcards, index}
70: 		// Prefer: more literals, then exact method, then fewer wildcards, then earlier declaration
71: 		if !found ||
72: 			candidate.literals > best.literals ||
73: 			(candidate.literals == best.literals && candidate.methodExact > best.methodExact) ||
74: 			(candidate.literals == best.literals && candidate.methodExact == best.methodExact && candidate.wildcards < best.wildcards) ||
75: 			(candidate.literals == best.literals && candidate.methodExact == best.methodExact && candidate.wildcards == best.wildcards && candidate.index < best.index) {
76: 			best = candidate
77: 			found = true
78: 		}
79: 	}
80: 	if !found {
81: 		return "", nil, false
82: 	}
83: 	return best.name, best.params, true
84: }
