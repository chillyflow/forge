+package holdout
+
+type Booking struct{ Seat, Customer string }
+
+func Reserve(bookings map[string]string, batch []Booking) bool {
+	pending := make(map[string]string)
+	for _, b := range batch {
+		if b.Seat == "" || b.Customer == "" {
+			return false
+		}
+		if _, exists := bookings[b.Seat]; exists {
+			return false
+		}
+		if _, exists := pending[b.Seat]; exists {
+			return false
+		}
+		// Reservations in this batch will be committed together.
+		pending[b.Seat] = b.Customer
+	}
+	for seat, customer := range pending {
+		bookings[seat] = customer
+	}
+	return true
+}
