file_sha256:dc32f94aee3c33d25aea63d38058d17dd85a6f73d32e394c78700f894a97a569
1: package holdout
2: 
3: import (
4: 	"reflect"
5: 	"testing"
6: )
7: 
8: func TestWaves(t *testing.T) {
9: 	deps := map[string][]string{"app": {"lib", "assets"}, "lib": {"core"}, "core": {}, "assets": {}}
10: 	want := [][]string{{"assets", "core"}, {"lib"}, {"app"}}
11: 	for i := 0; i < 20; i++ {
12: 		got, err := BuildWaves(deps)
13: 		if err != nil || !reflect.DeepEqual(got, want) {
14: 			t.Fatalf("waves %v, error %v", got, err)
15: 		}
16: 	}
17: 	for _, bad := range []map[string][]string{{"a": {"b"}, "b": {"a"}}, {"a": {"missing"}}, {"a": {"a"}}} {
18: 		if _, err := BuildWaves(bad); err == nil {
19: 			t.Fatal("invalid graph accepted")
20: 		}
21: 	}
22: 	got, err := BuildWaves(map[string][]string{})
23: 	if err != nil || len(got) != 0 {
24: 		t.Fatal(got, err)
25: 	}
26: 	got, err = BuildWaves(map[string][]string{"a": {}, "b": {"a", "a"}})
27: 	if err != nil || !reflect.DeepEqual(got, [][]string{{"a"}, {"b"}}) {
28: 		t.Fatal(got, err)
29: 	}
30: }
