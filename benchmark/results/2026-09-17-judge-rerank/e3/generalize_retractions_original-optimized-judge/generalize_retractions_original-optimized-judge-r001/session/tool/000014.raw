file_sha256:ba91530aae6f0437f109832457f4b59a006450a8102b815f96ed1704f7276660
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             account, amount = event['account'], event['amount']
10:             postings[event['id']] = (account, amount)
11:             # If this posting was already cancelled by a retraction, don't process it
12:             if event['id'] in cancelled:
13:                 continue
14:             totals.setdefault(account, 0)
15:             totals[account] += amount
16:         else:
17:             target = event['target']
18:             if target in cancelled:
19:                 continue
20:             cancelled.add(target)
21:             if target in postings:
22:                 account, amount = postings[target]
23:                 totals[account] -= amount
24:             # If the posting hasn't arrived yet, we still mark it as cancelled
25:             # so that when it arrives, we won't process it
26:     return totals
