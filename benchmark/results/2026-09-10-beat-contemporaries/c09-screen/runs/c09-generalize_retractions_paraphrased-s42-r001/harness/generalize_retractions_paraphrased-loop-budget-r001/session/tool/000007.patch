+def balances(events):
+    seen, cancelled = set(), set()
+    postings, totals = {}, {}
+    for event in events:
+        if event['id'] in seen:
+            continue
+        seen.add(event['id'])
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            postings[event['id']] = (account, amount)
+            totals.setdefault(account, 0)
+            totals[account] += amount
+        else:
+            target = event['target']
+            if target in cancelled:
+                continue
+            cancelled.add(target)
+            if target in postings:
+                account, amount = postings[target]
+                totals[account] -= amount
+            # If target is not in postings, it's an unknown reference, so no account is created
+    # Handle case where a post might have been cancelled by a retract that came later
+    # This is already handled by the logic above - if a retract comes after a post,
+    # the post is already in postings and will be cancelled when the retract is processed
+    return totals
