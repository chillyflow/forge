file_sha256:05b76ea2c974cc4a1d54ec2bbb009dd61ca41ab193b871af8ccef1e591240724
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             account, amount = event['account'], event['amount']
10:             # If this posting has been cancelled by a retraction, don't apply it
11:             if event['id'] in cancelled:
12:                 continue
13:             postings[event['id']] = (account, amount)
14:             totals.setdefault(account, 0)
15:             totals[account] += amount
16:         else:
17:             target = event['target']
18:             if target in cancelled:
19:                 continue
20:             cancelled.add(target)
21:             if target in postings:
22:                 account, amount = postings[target]
23:                 totals[account] -= amount
24:     return totals
