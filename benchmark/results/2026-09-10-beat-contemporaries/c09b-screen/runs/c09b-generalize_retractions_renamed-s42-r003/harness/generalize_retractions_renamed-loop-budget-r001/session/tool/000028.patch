+#!/usr/bin/env python3
+
+# Replicate the exact test
+import unittest
+from ledger import positions_for
+
+def post(i, delta): 
+    return {'key': i, 'kind': 'post', 'bucket': 'cash', 'delta': delta}
+
+def retract(i, reference): 
+    return {'key': i, 'kind': 'retract', 'reference': reference}
+
+class JournalCases(unittest.TestCase):
+    def test_order_and_duplicates(self):
+        p = post('p', 7)
+        for messages in [[p, retract('r', 'p')], [retract('r', 'p'), p],
+                       [p, p, retract('r', 'p'), retract('s', 'p')]]:
+            result = positions_for(messages)
+            expected = {'cash': 0}
+            print(f"Messages: {messages}")
+            print(f"Result: {result}")
+            print(f"Expected: {expected}")
+            print(f"Match: {result == expected}")
+            print("---")
+            self.assertEqual(result, expected)
+
+if __name__ == '__main__':
+    unittest.main()
