1: package ledger
2: 
3: import "errors"
4: 
5: func Transfer(from, to *Ledger, amount int) error {
6: 	if !from.debit(amount) {
7: 		return errors.New("insufficient funds")
8: 	}
9: 	to.Balance += amount
10: 	return nil
11: }
