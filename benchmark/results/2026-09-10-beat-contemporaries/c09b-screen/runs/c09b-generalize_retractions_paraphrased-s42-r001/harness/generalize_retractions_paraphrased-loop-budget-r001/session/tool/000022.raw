file_sha256:30cfb6e5b9ba0d64454ae678203a2ddf16af50479a3948ec7dbb62af134d0c7b
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             account, amount = event['account'], event['amount']
10:             # If this post has been cancelled already, skip it
11:             if event['id'] in cancelled:
12:                 continue
13:             postings[event['id']] = (account, amount)
14:             totals.setdefault(account, 0)
15:             totals[account] += amount
16:         else:
17:             target = event['target']
18:             # Mark target as cancelled, regardless of whether it exists in postings
19:             cancelled.add(target)
20:             if target in postings:
