file_sha256:2cc3023b71c897f930c9ca8686f3f597f000ef2a9179cc643289a30d48039b2b
1: def positions_for(messages):
2:     visited, voided = set(), set()
3:     entries, positions = {}, {}
4:     for message in messages:
5:         if message['key'] in visited:
6:             continue
7:         visited.add(message['key'])
8:         if message['kind'] == 'post':
9:             bucket, delta = message['bucket'], message['delta']
10:             if message['key'] in voided:
11:                 continue
12:             entries[message['key']] = (bucket, delta)
13:             positions.setdefault(bucket, 0)
14:             positions[bucket] += delta
15:         else:
16:             reference = message['reference']
17:             if reference in voided:
18:                 continue
19:             voided.add(reference)
20:             if reference in entries:
21:                 bucket, delta = entries[reference]
22:                 positions[bucket] -= delta
23:     # Ensure that if we have at least one bucket referenced, it appears in the result
24:     # This handles the case where positions might be empty but should still show buckets
25:     return positions
