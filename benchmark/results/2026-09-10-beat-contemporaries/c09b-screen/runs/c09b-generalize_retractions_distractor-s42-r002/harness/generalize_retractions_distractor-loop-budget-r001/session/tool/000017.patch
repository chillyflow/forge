+def balances(events):
+    seen = set()
+    cancelled = set()
+    postings = {}
+    totals = {}
+    
+    for event in events:
+        # Skip if this event ID has already been processed
+        if event['id'] in seen:
+            continue
+            
+        seen.add(event['id'])
+        
+        if event['kind'] == 'post':
+            account, amount = event['account'], event['amount']
+            postings[event['id']] = (account, amount)
+            totals.setdefault(account, 0)
+            totals[account] += amount
+        else:
+            target = event['target']
+            # If this retraction targets a posting that's already been cancelled, skip it
+            if target in cancelled:
+                continue
+                
+            cancelled.add(target)
+            # If the posting exists, subtract its amount from the total
+            if target in postings:
+                account, amount = postings[target]
+                totals[account] -= amount
+            # If posting doesn't exist yet, it will be ignored when it arrives
+    return totals
