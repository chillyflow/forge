1: def positions_for(messages):
2:     visited, voided = set(), set()
3:     entries, positions = {}, {}
4:     
5:     for message in messages:
6:         if message['key'] in visited:
7:             continue
8:         visited.add(message['key'])
9:         
10:         if message['kind'] == 'post':
11:             # If this post has been voided by a retraction, skip it
12:             if message['key'] in voided:
13:                 continue
14:             bucket, delta = message['bucket'], message['delta']
15:             entries[message['key']] = (bucket, delta)
16:             positions.setdefault(bucket, 0)
17:             positions[bucket] += delta
18:         else:  # message['kind'] == 'retract'
19:             reference = message['reference']
20:             if reference in voided:
