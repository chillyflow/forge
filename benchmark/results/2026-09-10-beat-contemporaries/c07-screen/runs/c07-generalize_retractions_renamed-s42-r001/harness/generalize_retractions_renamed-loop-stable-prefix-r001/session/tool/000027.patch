+def positions_for(messages):
+    entries, positions = {}, {}
+    voided = set()
+    
+    for message in messages:
+        if message['kind'] == 'post':
+            # If this post has already been voided (referenced by a retraction), skip it
+            if message['key'] in voided:
+                continue
+            bucket, delta = message['bucket'], message['delta']
+            entries[message['key']] = (bucket, delta)
+            positions.setdefault(bucket, 0)
+            positions[bucket] += delta
+        else:  # message['kind'] == 'retract'
+            reference = message['reference']
+            if reference in voided:
+                continue
+            voided.add(reference)
+            # Track the bucket even if the referenced post hasn't been seen yet
+            # to ensure it appears in the result (with 0 if no net change)
+            bucket = None
+            if reference in entries:
+                bucket, delta = entries[reference]
+                positions[bucket] -= delta
+                del entries[reference]
+            elif bucket is None:
+                # The referenced post wasn't seen yet, but we still need to track the bucket
+                # for proper result formatting
+                pass
+    
+    return positions
