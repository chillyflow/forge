file_sha256:829cc7f9d83912c3b8c1156af32f1861eedc380480d2583625d788c6d9d6a0a9
1: def balances(events):
2:     seen, cancelled = set(), set()
3:     postings, totals = {}, {}
4:     for event in events:
5:         if event['id'] in seen:
6:             continue
7:         seen.add(event['id'])
8:         if event['kind'] == 'post':
9:             account, amount = event['account'], event['amount']
10:             postings[event['id']] = (account, amount)
11:             # Only add to total if not cancelled
12:             if event['id'] not in cancelled:
13:                 totals.setdefault(account, 0)
14:                 totals[account] += amount
15:         else:
16:             target = event['target']
17:             if target in cancelled:
18:                 continue
19:             cancelled.add(target)
20:             if target in postings:
